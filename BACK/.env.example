PORT=8000
MONGO_CONNECTION_STRING=mongodb://127.0.0.1:27017/faceatutor

# Long random string (openssl rand -base64 48)
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Used in email links and for CORS (comma-separated list allowed in CORS_ORIGINS)
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Optional: course file uploads. Without it, teachers share links only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: Gmail account + app password. Without it, emails are printed to the console.
EMAIL_SERVICE=Gmail
EMAIL_USERNAME=
EMAIL_PASSWORD=

# First super admin created by `npm run seed`
SEED_SUPERADMIN_NAME=Super Admin
SEED_SUPERADMIN_EMAIL=superadmin@faceatutor.tn
SEED_SUPERADMIN_PASSWORD=SuperAdmin123
